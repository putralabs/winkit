{
  "name": "winkit",
  "private": true,
  "version": "0.1.0",
  "author": "putralabs",
  "description": "WinKit - Your Everyday File Toolkit (Chrome Extension, Manifest V3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "build:all": "npm run build && npm run build:web",
    "serve:web": "node scripts/serve-web.mjs",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "blueimp-md5": "^2.19.0",
    "docx": "^9.7.1",
    "exifr": "^7.1.3",
    "gifenc": "^1.0.3",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "mammoth": "^1.12.3",
    "pako": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.2.67",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
